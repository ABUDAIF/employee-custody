{
  "name": "employee-custody-app",
  "version": "1.0.0",
  "description": "Employee Custody Management System — Commercial Grade Ledger Accounting",
  "main": "dist-electron/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dist": "node ./node_modules/vite/bin/vite.js build && node ./scripts/prepare-prisma.mjs && node ./node_modules/electron-builder/out/cli/cli.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^10.18.0",
    "html5-qrcode": "^2.3.8",
    "node-telegram-bot-api": "^0.66.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "com.employeecustody.app",
    "productName": "employee-custody-app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "prisma/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@prisma/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
